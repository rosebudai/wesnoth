# Web experiment defaults for utils/dockerbuilds/make_emscripten_build.
# Update this file for each new E## before running a build so flags are
# captured in git history.

EXP_ID='E48'
EXP_DESCRIPTION='explicit quoted-empty OFFSCREENCANVASES_TO_PTHREAD to disable default #canvas transfer'

EXP_WESNOTH_USE_PTHREADS='1'
EXP_WESNOTH_PROXY_TO_PTHREAD='1'
EXP_WESNOTH_PTHREAD_POOL_SIZE='4'
EXP_WESNOTH_CMAKE_BUILD_TYPE='Release'
EXP_WESNOTH_EXTRA_CMAKE_ARGS='-DWESNOTH_EMSCRIPTEN_ASSERTIONS=0'
EXP_WESNOTH_EXTRA_EM_FLAGS='-sLZ4=1 -sOFFSCREENCANVAS_SUPPORT=1 -sOFFSCREENCANVASES_TO_PTHREAD=\"\"'
EXP_WESNOTH_EXTRA_EM_LINK_FLAGS='-g0'

EXP_WESNOTH_PACKAGE_DATA='1'
EXP_WESNOTH_DATA_LZ4='auto'
