# Web experiment defaults for utils/dockerbuilds/make_emscripten_build.
# Update this file for each new E## before running a build so flags are
# captured in git history.

EXP_ID='E64'
EXP_DESCRIPTION='E63 + audio enabled (remove --nosound and SDL_AUDIODRIVER=dummy, add autoplay resume)'

EXP_WESNOTH_USE_PTHREADS='1'
EXP_WESNOTH_PROXY_TO_PTHREAD='0'
EXP_WESNOTH_PTHREAD_POOL_SIZE='4'
EXP_WESNOTH_CMAKE_BUILD_TYPE='Release'
EXP_WESNOTH_EXTRA_CMAKE_ARGS='-DCMAKE_MODULE_PATH=/wesnoth/utils/dockerbuilds/emscripten/cmake-modules'
EXP_WESNOTH_EXTRA_EM_FLAGS='-sLZ4=1 -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=65536'
EXP_WESNOTH_EXTRA_EM_LINK_FLAGS=''

EXP_WESNOTH_PACKAGE_DATA='1'
EXP_WESNOTH_DATA_LZ4='auto'
